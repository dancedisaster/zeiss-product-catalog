{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Catalog": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedSampleData": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitPerMinute": 300
  },
  "RequestTimeouts": {
    "Default": "00:00:30"
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  }
}
